# Hugo 构建输出（由 Actions 生成）
/public/
/resources/_gen/
.hugo_build.lock 

# 操作系统缓存
.DS_Store
Thumbs.db 
desktop.ini 

# 开发环境配置
.idea/            # JetBrains IDE
.vscode/          # VS Code
.env              # 敏感环境变量
*.swp             # Vim 临时文件

# 主题子模块处理（推荐方式）
themes/*          # 忽略主题内容
!themes/          # 保留目录（允许子模块存在）
themes/**/*       # 递归忽略主题内文件
!themes/*/        # 保留每个主题的目录名

# hugo 可执行文件，LoveIt暂时与v148版本不兼容,此处hugo为v145
hugo
